#!/usr/bin/env bash
#
# Copy this file to config/.env and fill in your values.
# IMPORTANT: Never commit config/.env to version control.

export DEBUG="false"
export APP_FULL_BASE_URL="https://yourdomain.com"
export SECURITY_SALT="__GENERATE_A_UNIQUE_RANDOM_STRING__"

export DATABASE_HOST="localhost"
export DATABASE_PORT="3306"
export DATABASE_NAME="cerrajeria"
export DATABASE_USER="root"
export DATABASE_PASSWORD=""

# Optional: use a single DATABASE_URL instead of individual settings
# export DATABASE_URL="mysql://user:password@localhost/cerrajeria?encoding=utf8"
